    - "\u52A0\u5165\u5FC3\u613F\u5355"
    - "\u52A0\u5165\u9858\u671B\u6E05\u55AE"
    - "\u30A6\u30A3\u30C3\u30B7\u30E5\u30EA\u30B9\u30C8\u306B\u8FFD\u52A0"
    - "\uC704\uC2DC\uB9AC\uC2A4\uD2B8\uC5D0 \uCD94\uAC00"
    - "\u0412 \u0416\u0415\u041B\u0410\u0415\u041C\u041E\u0415"
